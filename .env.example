# LLM Configuration
LLM_PROVIDER=google             # google, openai, ollama
LLM_MODEL=gemini-2.0-flash      # model name
LLM_API_KEY=your-api-key-here   # API key (never commit the real value)
LLM_BASE_URL=                   # optional: custom endpoint for ollama etc.
LLM_TEMPERATURE=0.1             # low temperature for factual grounding

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2   # sentence-transformers model
EMBEDDING_DEVICE=cpu                # cpu or cuda

# Retrieval Configuration
RETRIEVAL_TOP_K=5               # number of evidence chunks to retrieve
HYBRID_ALPHA=0.4                # weight for BM25 (1-alpha for semantic)

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
